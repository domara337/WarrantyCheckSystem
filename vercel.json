{
  "services": {
    "backend": {
      "root": "Backend",
      "framework": "express"
    },
    "frontend": {
      "root": "Frontend",
      "framework": "vite"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": { "service": "backend" }
    },
    {
      "source": "/((?!api/).*)",
      "destination": { "service": "frontend", "path": "/index.html" }
    }
  ]
}