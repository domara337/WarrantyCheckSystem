{
  "builds": [
    {
      "src": "Backend/index.ts",
      "use": "@vercel/node"
    },
    {
      "src": "Frontend/package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "dist"
      }
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "Backend/index.ts"
    },
    {
      "src": "/(.*)",
      "dest": "index.html"
    }
  ]
}