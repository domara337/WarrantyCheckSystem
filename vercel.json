{
  "services": {
    "backend": {
      "root": "Backend",
      "framework": "express"
    },
    "frontend": {
      "root": "Frontend",
      "framework": "vite"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": { "service": "Backend" }
    },
    {
      "source": "/(.*)",
      "destination": { "service": "Frontend" }
    }
  ]
}